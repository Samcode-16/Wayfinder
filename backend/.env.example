# --- LLM providers (set at least one; order of fallback: Groq -> Gemini -> HF) ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# --- Optional live flight/hotel data (https://serpapi.com, free tier ~100 searches/month).
# Leave empty to use clearly-labelled demo data. ---
SERPAPI_API_KEY=

# --- Optional Geoapify API key for maps & geocoding (https://www.geoapify.com, free tier 3000 req/day). ---
GEOAPIFY_API_KEY=

DB_PATH=travel_agent.sqlite
